DEEPSEEK_API_KEY=
SCRAPPA_API_KEY=
SERANKING_API_KEY=

# Optional - shares the same Supabase project as the rest of this repo. If
# this file lives at seo-funnel/article-pipeline/.env, you likely don't need
# these at all: load_dotenv() walks up to seo-funnel/.env automatically, so
# one root .env can cover both pipelines. Leave unset to run purely locally -
# no interlinking, no backlinking, no WordPress publish, no scheduler.
SUPABASE_URL=
SUPABASE_KEY=

# 'publish' or 'draft'. Everything ships live by default - set to 'draft'
# to require manual review in WP admin before anything goes public.
WP_PUBLISH_STATUS=publish

# how many top organic results count as "competitors" for research -
# raised to 10 so common-content and hard structural targets (word/
# paragraph/heading counts) have a real sample to derive from
COMPETITOR_COUNT=10
# candidates generated PER OUTLINE SECTION, not a global article total -
# each candidate in the batch is covered by one flat-rate SE Ranking call
# regardless of how many sections contribute to it
MAX_KEYWORDS_PER_SECTION=5
